# ── Groq Vision ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...                    # https://console.groq.com
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── OpenRouter (Qwen2.5-VL) ───────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...         # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_QWEN_MODEL=qwen/qwen2.5-vl-72b-instruct

# ── PaddleOCR-VL-1.5 (optional) ───────────────────────────────────────────────
PADDLEOCR_TOKEN=...                     # https://aistudio.baidu.com/usercenter/token
PADDLEOCR_SYNC_URL=https://...          # AIStudio sync endpoint URL

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=True

# ── Benchmark ─────────────────────────────────────────────────────────────────
BENCHMARK_DATASET_PATH=test_dataset/
BENCHMARK_OUTPUT_DIR=benchmark_output/
BENCHMARK_THRESHOLD=0.85

# ── Weights & Biases (optional) ───────────────────────────────────────────────
WANDB_ENABLED=false
WANDB_PROJECT=arabic-cin-ocr
# WANDB_API_KEY=...
